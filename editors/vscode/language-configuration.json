{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["comment"]
    }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "(-?\\d+(?:\\.\\d+)?)|([A-Za-z_][A-Za-z0-9_]*!?)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:pub\\s+)?struct\\b|(?:pub\\s+)?fn\\b(?![^#\\n]*\\)\\s*=)|(?:if|elsif|else|when|for)\\b|.*\\bdo\\s*(?:#.*)?$)",
    "decreaseIndentPattern": "^\\s*(?:end|elsif|else)\\b"
  }
}
