{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hoomer",
  "scopeName": "source.hoomer",
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#definitions"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#values"
        },
        {
          "include": "#names"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ruby",
          "begin": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ruby"
            }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.ruby",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ruby"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ruby"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.ruby",
              "match": "\\\\[nrt\"\\\\]"
            },
            {
              "name": "constant.character.escape.ruby",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.embedded.line.ruby",
              "contentName": "source.hoomer",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.ruby"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.ruby"
                }
              },
              "patterns": [
                {
                  "include": "#main"
                }
              ]
            }
          ]
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "name": "meta.require.ruby",
          "match": "\\b(import)\\s+([a-z][a-z0-9]*(?:_[a-z0-9]+)*(?:/[a-z][a-z0-9]*(?:_[a-z0-9]+)*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.special-method.ruby"
            },
            "2": {
              "name": "string.unquoted.package-path.hoomer"
            }
          }
        },
        {
          "name": "meta.class.ruby",
          "match": "\\b(struct|error)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.class.ruby"
            },
            "2": {
              "name": "entity.name.type.class.ruby"
            }
          }
        },
        {
          "name": "meta.function.method.without-arguments.ruby",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*!?)",
          "captures": {
            "1": {
              "name": "keyword.control.def.ruby"
            },
            "2": {
              "name": "entity.name.function.ruby"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.class.ruby",
          "match": "\\b(?:struct|error)\\b"
        },
        {
          "name": "keyword.control.def.ruby",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.other.special-method.ruby",
          "match": "\\b(?:import|pub)\\b"
        },
        {
          "name": "keyword.control.ruby",
          "match": "\\b(?:as|if|elsif|else|when|end|for|while|in|is|and|or|not|break)\\b"
        },
        {
          "name": "keyword.control.start-block.ruby",
          "match": "\\bdo\\b"
        },
        {
          "name": "keyword.control.pseudo-method.ruby",
          "match": "\\b(?:return|try|continue)\\b"
        },
        {
          "name": "constant.language.boolean.ruby",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.nil.ruby",
          "match": "\\bnil\\b"
        },
        {
          "name": "variable.ruby",
          "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "constant.numeric.ruby",
          "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d+|\\d+)(?![A-Za-z0-9_])"
        },
        {
          "name": "variable.other.constant.ruby",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "support.function.kernel.ruby",
          "match": "\\b(?:print|reflection(?:_(?:get|set|call|load))?)\\b"
        },
        {
          "name": "entity.name.function.ruby",
          "match": "(?<=\\.)[a-z_][A-Za-z0-9_]*!?"
        },
        {
          "name": "constant.language.symbol.hashkey.ruby",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)",
          "captures": {
            "2": {
              "name": "punctuation.definition.constant.hashkey.ruby"
            }
          }
        },
        {
          "name": "entity.name.function.ruby",
          "match": "\\b[a-z_][A-Za-z0-9_]*!?(?=\\s*\\()"
        },
        {
          "name": "variable.other.constant.ruby",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ruby",
          "match": "==|!=|>=|<=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.ruby",
          "match": "[+*/-]"
        },
        {
          "name": "keyword.operator.assignment.ruby",
          "match": "="
        },
        {
          "name": "keyword.operator.other.ruby",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.separator.object.ruby",
          "match": ","
        },
        {
          "name": "punctuation.separator.method.ruby",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.other.ruby",
          "match": ":"
        },
        {
          "name": "punctuation.section.function.ruby",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.array.ruby",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.scope.ruby",
          "match": "[{}]"
        }
      ]
    }
  }
}
