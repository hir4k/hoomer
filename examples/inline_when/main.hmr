package InlineWhen

struct DatabaseConnection
    host,
end

struct DatabaseConnectionError
    message,
end

fn connect_database!(host, available: true)
    if available
        DatabaseConnection(host: host)
    else
        DatabaseConnectionError(
            message: "Could not connect to {host}",
        )
    end
end

fn create_offline_connection()
    print "Creating offline connection"
    DatabaseConnection(host: "offline")
end

fn main
    primary_connection = connect_database!(
        "primary.database.local",
    ) when DatabaseConnection else create_offline_connection()

    print "Matched: {primary_connection.host}"

    missing_connection = connect_database!(
        "missing.database.local",
        available: false,
    ) when DatabaseConnection else nil

    print "Without fallback: {missing_connection}"

    fallback_connection = connect_database!(
        "backup.database.local",
        available: false,
    ) when DatabaseConnection else create_offline_connection()

    print "With fallback: {fallback_connection.host}"
end
