import examples/checkout_showcase/hoomer/checkout_domain as Domain

PAYMENT_LIMIT_CENTS = 10000
LOYALTY_BONUS = 10

fn create_customer(
    name,
    email:,
    country: "India",
    premium: false,
    loyalty_points: 0,
)
    normalized_email = email

    Domain.Customer(
        name: name,
        email: normalized_email,
        country: country,
        premium: premium,
        loyalty_points: loyalty_points,
    )
end

fn validate_order!(items)
    for item in items
        if item.quantity <= 0
            return Domain.ValidationError(
                message: "{item.product.name} quantity must be positive",
            )
        end
    end

    Domain.ValidatedOrder(items: items)
end

fn reserve_inventory!(order)
    for item in order.items
        if item.quantity > item.product.available
            return Domain.InventoryError(
                product_name: item.product.name,
                requested: item.quantity,
                available: item.product.available,
            )
        end
    end

    Domain.InventoryReserved(items: order.items)
end

fn calculate_subtotal(items)
    subtotal_cents = 0

    for item in items
        line_total_cents = item.product.price_cents * item.quantity
        subtotal_cents = subtotal_cents + line_total_cents
    end

    subtotal_cents
end

fn is_international(customer)
    customer.country != "India"
end

fn calculate_discount(customer, subtotal_cents, coupon_code: nil)
    if is_international(customer)
        return 0
    end

    if coupon_code == "HUMAN10"
        subtotal_cents / 10
    elsif customer.premium
        subtotal_cents / 20
    else
        0
    end
end

fn describe_coupon(coupon_code)
    when coupon_code
        "HUMAN10":
            "HUMAN10"
        nil:
            "none"
        else as unknown_code:
            "{unknown_code} (unrecognized)"
    end
end

fn charge_payment!(amount_cents, limit_cents: PAYMENT_LIMIT_CENTS)
    if amount_cents > limit_cents
        return Domain.PaymentError(
            message: "Payment declined for {amount_cents} cents",
        )
    end

    Domain.PaymentApproved(amount_cents: amount_cents)
end

fn customer_level(customer)
    if customer.loyalty_points >= 100
        "gold"
    elsif customer.loyalty_points >= 50
        "silver"
    else
        "new"
    end
end

fn reward_customer(customer)
    customer.loyalty_points = customer.loyalty_points + LOYALTY_BONUS
end

fn notify_warehouse!(receipt)
    if receipt.charged_cents < 0
        return Domain.NotificationError(
            message: "Cannot notify the warehouse about a refund",
        )
    end

    Domain.NotificationSent(channel: "warehouse")
end

fn divider(width)
    if width <= 0
        return ""
    end

    "-{divider(width - 1)}"
end

fn audit(label, &block)
    print("Audit started: {label}")
    block()
    print("Audit finished: {label}")
end

pub fn checkout!(
    customer,
    items,
    coupon_code: nil,
    payment_limit_cents: PAYMENT_LIMIT_CENTS,
)
    validated_order = when validate_order!(items)
        Domain.ValidatedOrder as order:
            order
        Domain.ValidationError as error:
            return error
        else:
            return Domain.UnexpectedCheckoutError(
                message: "Validation returned an unknown value",
            )
    end

    reserved_inventory = when reserve_inventory!(validated_order)
        Domain.InventoryReserved as reservation:
            reservation
        Domain.InventoryError as error:
            return error
        else:
            return Domain.UnexpectedCheckoutError(
                message: "Inventory returned an unknown value",
            )
    end

    subtotal_cents = calculate_subtotal(reserved_inventory.items)
    discount_cents = calculate_discount(
        customer,
        subtotal_cents,
        coupon_code: coupon_code,
    )
    charged_cents = subtotal_cents - discount_cents

    payment = when charge_payment!(
        charged_cents,
        limit_cents: payment_limit_cents,
    )
        Domain.PaymentApproved as approval:
            approval
        Domain.PaymentError as error:
            return error
        else:
            return Domain.UnexpectedCheckoutError(
                message: "Payment returned an unknown value",
            )
    end

    reward_customer(customer)

    Domain.Receipt(
        customer_name: customer.name,
        customer_level: customer_level(customer),
        subtotal_cents: subtotal_cents,
        discount_cents: discount_cents,
        charged_cents: payment.amount_cents,
        coupon_code: coupon_code,
    )
end

fn show_result(result)
    when result
        Domain.Receipt as receipt:
            print("Approved for {receipt.customer_name} ({receipt.customer_level})")
            print("Subtotal: {receipt.subtotal_cents} cents")
            print("Discount: {receipt.discount_cents} cents")
            print("Charged: {receipt.charged_cents} cents")
            print("Coupon: {describe_coupon(receipt.coupon_code)}")
            notification = notify_warehouse!(receipt)
            when notification
                Domain.NotificationError as error:
                    print(error.message)
                else:
                    nil
            end

        Domain.ValidationError as error:
            print("Invalid order: {error.message}")

        Domain.InventoryError as error:
            print("Not enough {error.product_name}: requested {error.requested}, available {error.available}")

        Domain.PaymentError as error:
            print(error.message)

        else:
            print("Unexpected checkout result")
    end
end

fn show_language_metadata(sample_product)
    product_info = reflection(sample_product)
    function_info = reflection(checkout!)

    print("Reflected struct: {product_info.name} {product_info.fields}")
    print("Reflected function: {function_info.name} {function_info.parameters}")
end

fn main
    keyboard = Domain.Product(
        name: "Keyboard",
        price_cents: 2500,
        available: 2,
    )
    mouse = Domain.Product(
        name: "Mouse",
        price_cents: 900,
        available: 5,
    )
    monitor = Domain.Product(
        name: "Monitor",
        price_cents: 12000,
        available: 1,
    )

    customer = create_customer(
        "Hirak",
        email: "hirak@example.com",
        premium: true,
        loyalty_points: 95,
    )

    print(divider(42))
    print("Customer: {customer.name} <{customer.email}>")
    show_language_metadata(keyboard)

    audit("three checkout attempts") do
        successful_items = [
            Domain.OrderItem(product: keyboard, quantity: 1),
            Domain.OrderItem(product: mouse, quantity: 1),
        ]
        successful_result = checkout!(
            customer,
            successful_items,
            coupon_code: "HUMAN10",
        )
        show_result(successful_result)

        print("")
        unavailable_items = [
            Domain.OrderItem(product: keyboard, quantity: 3),
        ]
        unavailable_result = checkout!(customer, unavailable_items)
        show_result(unavailable_result)

        print("")
        expensive_items = [
            Domain.OrderItem(product: monitor, quantity: 1),
        ]
        payment_result = checkout!(
            customer,
            expensive_items,
            payment_limit_cents: 10000,
        )
        show_result(payment_result)
    end

    for day in 1..3
        if day == 2
            continue
        end

        print("Tracking update: day {day}")
    end
end
