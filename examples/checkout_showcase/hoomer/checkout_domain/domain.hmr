pub struct Customer
    name,
    email,
    country: "India",
    premium: false,
    loyalty_points: 0,
end

pub struct Product
    name,
    price_cents,
    available,
end

pub struct OrderItem
    product,
    quantity,
end

pub struct ValidatedOrder items end

pub struct InventoryReserved items end

pub struct PaymentApproved amount_cents end

pub struct Receipt
    customer_name,
    customer_level,
    subtotal_cents,
    discount_cents,
    charged_cents,
    coupon_code: nil,
end

pub error ValidationError message end

pub error InventoryError
    product_name,
    requested,
    available,
end

pub error PaymentError message end

pub struct NotificationSent channel end

pub error NotificationError message end

pub error UnexpectedCheckoutError message end

