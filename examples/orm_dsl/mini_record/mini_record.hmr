pub struct Model
    name,
    table,
    fields,
end

pub struct Query
    model,
    statement,
end

pub error ModelMismatchError
    table,
    expected_model,
    received_model,
end

pub fn model(sample_record, table:)
    record_info = reflection(sample_record)

    Model(
        name: record_info.name,
        table: table,
        fields: record_info.fields,
    )
end

pub fn migrate(model)
    print("Model {model.name} maps to {model.table}")
    print("Fields: {model.fields}")
end

pub fn create!(model, record)
    record_info = reflection(record)

    if record_info.name != model.name
        return ModelMismatchError(
            table: model.table,
            expected_model: model.name,
            received_model: record_info.name,
        )
    end

    print("Inserted {record_info.name} into {model.table}")
    record
end

pub fn all(model)
    Query(
        model: model,
        statement: "SELECT * FROM {model.table}",
    )
end

pub fn where(query, field:, equals:)
    Query(
        model: query.model,
        statement: "{query.statement} WHERE {field} = {equals}",
    )
end

pub fn limit(query, count: 100)
    Query(
        model: query.model,
        statement: "{query.statement} LIMIT {count}",
    )
end

pub fn execute(query)
    print(query.statement)
end

pub fn transaction(&block)
    print("BEGIN")
    block()
    print("COMMIT")
end
