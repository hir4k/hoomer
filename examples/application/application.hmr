import examples/accounts

pub fn show_user(user)
    print("ID: {user.id}")
    print("Name: {user.name}")
    print("Email: {user.email}")
    print("Age: {user.age}")
end

fn main
    create_result = accounts.create_user!(
        "Hirak",
        "hirak@example.com",
        age: 26,
    )

    when create_result
        accounts.User as response:
            message = accounts.greet(
                response,
                greeting: "Welcome",
            )

            print(message)

        accounts.ValidationError as response:
            print("Invalid {response.field}: {response.message}")

        accounts.DatabaseError as response:
            print("Database error: {response.message}")

        nil:
            print("No user was created")

        else:
            print("Unknown result")
    end

    find_result = accounts.find_user!(10)

    when find_result
        accounts.User as user:
            show_user(user)

            when user.city
                "Guwahati":
                    print("User lives in Guwahati")

                nil:
                    print("City was not provided")

                else:
                    print("User lives somewhere else")
            end

        accounts.ValidationError as error:
            print(error.message)

        accounts.DatabaseError as error:
            print("Database failed with code {error.code}")

        nil:
            print("User was not found")

        else:
            print("Unexpected value")
    end

    users = [
        accounts.User(
            name: "Hirak",
            email: "hirak@example.com",
            age: 26,
        ),

        accounts.User(
            name: "Rahul",
            email: "rahul@example.com",
            age: 16,
        ),
    ]

    for user in users
        if user.active == false
            continue
        end

        print(accounts.greet(user))
    end
end
