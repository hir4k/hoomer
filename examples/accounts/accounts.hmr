package Accounts

MAX_NAME_LENGTH = 100

pub struct User
    id: nil,
    name,
    email,
    age: 0,
    active: true,
    city: nil,
end

pub struct ValidationError
    field,
    message,
end

pub struct DatabaseError
    message,
    code: nil,
end

pub fn is_adult(user)
    user.age >= 18
end

pub fn create_user!(
    name,
    email,
    age: 0,
    active: true,
)
    if name == ""
        return ValidationError(
            field: "name",
            message: "Name cannot be empty",
        )
    end

    if email == ""
        return ValidationError(
            field: "email",
            message: "Email cannot be empty",
        )
    end

    User(
        name: name,
        email: email,
        age: age,
        active: active,
    )
end

pub fn find_user!(id)
    if id <= 0
        return ValidationError(
            field: "id",
            message: "ID must be greater than zero",
        )
    end

    if id == 404
        return nil
    end

    if id == 500
        return DatabaseError(
            message: "Database connection failed",
            code: 500,
        )
    end

    User(
        id: id,
        name: "Hirak",
        email: "hirak@example.com",
        age: 26,
    )
end

pub fn greet(
    user,
    greeting: "Hello",
    punctuation: "!",
)
    if is_adult(user)
        "{greeting} {user.name}{punctuation}"
    else
        "Hi {user.name}{punctuation}"
    end
end
