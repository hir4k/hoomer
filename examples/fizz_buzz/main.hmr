package FizzBuzz

fn is_divisible(number, divisor)
    if number == 0
        return true
    end

    if number < 0
        return false
    end

    is_divisible(number - divisor, divisor)
end

fn fizzbuzz_value(number)
    is_fizz = is_divisible(number, 3)
    is_buzz = is_divisible(number, 5)

    if is_fizz
        if is_buzz
            return "FizzBuzz"
        end

        return "Fizz"
    end

    if is_buzz
        return "Buzz"
    end

    number
end

fn print_fizzbuzz(number, limit)
    if number > limit
        return
    end

    print(fizzbuzz_value(number))
    print_fizzbuzz(number + 1, limit)
end

fn main
    print_fizzbuzz(1, 100)
end
